# deps / build output
node_modules/
tools/im-patch/pristine/
tools/im-patch/reference/
tools/im-patch/backup/lib-index.js.orig
# full bundle backups are big (9 MB each) and not needed to rebuild
tools/im-patch/backup/lib-index.js.*
tools/im-patch/backup/pre-apply-*/
# 运行时配置备份（含真实 botId / openid / 会话 key），只在本地留存
tools/im-patch/backup/*.bak-*
tools/im-patch/*.tgz
tools/im-patch/package-lock.json.orig
# 本机构建证据（含绝对路径；每台机器用 node tools/im-patch/build-im.mjs 自己生成）
tools/im-patch/build-manifest.json

# runtime data (never commit)
*.log
*.wav
*.silk
*.pth
*.onnx
*.ckpt
*.safetensors
models/
weights/
characters/
dataset/
logs/
*.db
*.sqlite

# never commit credentials
.github-token
.github-token.*
*.token
.env
.env.*

# 本地个人值：botId / QQ 数据目录 / 主人身份标识；样例见 config.local.example.json
config.local.json
.env.local

# 表情导入的中间产物（他人版权图片，不提交）
_sticker-import/

# Python 字节码
__pycache__/
*.pyc
